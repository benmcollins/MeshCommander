#!/bin/bash
set -euo pipefail

NAME=MeshCommander
BASE="$(cd "${0%/*}" && pwd)"
OUT="${BASE}/build/${NAME}-osxarm64"
APP="${OUT}/${NAME}.app"

rm -rf "${OUT}"
mkdir -p "${OUT%/*}"

## Build via nw-builder (ESM).
## Run from inside source/ so glob-expanded paths land directly under app.nw/
## instead of app.nw/source/.
cd "${BASE}/source"
node --input-type=module -e "
import nwbuild from 'nw-builder';
await nwbuild({
  mode: 'build',
  srcDir: './**',
  outDir: '../build/${NAME}-osxarm64',
  platform: 'osx',
  arch: 'arm64',
  // Pin to 0.84.x: NW.js >= 0.85 ships Node 22 which removed
  // crypto.createCipher/createDecipher. Commander.htm's loadComputers()
  // uses createDecipher to read the existing encrypted localStorage
  // entry — losing it makes prior config appear empty.
  version: '0.84.0',
  glob: true,
  app: {
    name: '${NAME}',
    icon: '../files/nw.icns',
    LSApplicationCategoryType: 'public.app-category.utilities',
    CFBundleName: '${NAME}',
    CFBundleDisplayName: '${NAME}',
    CFBundleSpokenName: '${NAME}',
    CFBundleIdentifier: 'com.insynergy.${NAME}',
    CFBundleVersion: '0.9.5',
    CFBundleShortVersionString: '0.9.5',
    NSHumanReadableCopyright: 'Intel Corporation',
    NSLocalNetworkUsageDescription: '${NAME} communicates with Intel AMT devices on the local network.',
  },
});
"

## Localized strings (About panel etc.)
cp -R "${BASE}/files/en.lproj" "${APP}/Contents/Resources/"

## Ad-hoc sign the bundle so Gatekeeper lets it launch locally.
## Sign inside-out: frameworks/helpers first, then the outer app.
FW="${APP}/Contents/Frameworks/nwjs Framework.framework"
if [[ -d "${FW}" ]]; then
  find "${FW}/Versions/Current/Helpers" -name "*.app" -maxdepth 1 -print0 \
    | xargs -0 -I{} codesign --force --sign - "{}"
  for dylib in "${FW}/Versions/Current/"*.dylib; do
    [[ -f "${dylib}" ]] && codesign --force --sign - "${dylib}"
  done
  for helper in "${FW}/Versions/Current/Helpers/"*; do
    [[ -f "${helper}" && -x "${helper}" ]] && codesign --force --sign - "${helper}" || true
  done
  codesign --force --sign - "${FW}"
fi
codesign --deep --force --sign - "${APP}"

codesign --verify --deep --verbose=2 "${APP}"
echo ""
echo "Built: ${APP}"
