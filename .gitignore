.DS_Store
/build/
/build-*/

# Pre-built branding artifacts that CI / packaging needs verbatim.
# Regenerate via branding/build-icons.py — intermediate PNGs and
# the iconset stay ignored.
!branding/build/
branding/build/*
!branding/build/qumesh.icns
!branding/build/qumesh.ico
!branding/build/og-image.png
!branding/build/dmg-background.tiff
!branding/build/dmg-background.png
!branding/build/dmg-background@2x.png
!branding/build/qumesh-dmg.icns
!branding/build/png/
!branding/build/png/qumesh-mark-*.png

/.claude/
